COMPOSE_PROJECT_NAME=datasherlock-harness

API_PORT=8000
FRONTEND_PORT=8501
POSTGRES_PORT=5432

POSTGRES_DB=datasherlock
POSTGRES_USER=datasherlock
POSTGRES_PASSWORD=change-me

# PostgreSQL is the deployment checkpoint source of truth. Use file only for local tests.
INCIDENT_CHECKPOINT_BACKEND=postgres
INCIDENT_AUDIT_RETENTION_DAYS=365
POSTGRES_BACKUP_RETENTION_DAYS=30
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
AUDIT_RETENTION_INTERVAL_SECONDS=86400

DUCKDB_PATH=/workspace/data/processed/datasherlock.duckdb

# Local approval identities. Each identity needs the repair:approve permission.
# INCIDENT_APPROVAL_IDENTITIES=[{"token":"replace-with-a-secret-token","subject":"approver@example.com","permissions":["repair:approve"],"identity_source":"static_bearer"}]

# LLM configuration. Leave OPENAI_BASE_URL empty to use the OpenAI default.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
RUN_LLM_INTEGRATION_TESTS=0
